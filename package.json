{
  "name": "elementar",
  "private": true,
  "description": "Ferramentas de desenvolvimento do Elementar. O jogo não tem dependências: o navegador carrega os arquivos como estão.",
  "scripts": {
    "compilar": "node ferramentas/compilar.js",
    "tipos": "tsc -p tsconfig.json",
    "formatar": "prettier --write src js testes \"ferramentas/*.js\"",
    "formato": "prettier --check src js testes \"ferramentas/*.js\"",
    "verificar": "node testes/verificar.js",
    "reproduzir": "node testes/reproduzir.js"
  },
  "devDependencies": {
    "prettier": "3.10.0",
    "typescript": "5.9.3"
  }
}
